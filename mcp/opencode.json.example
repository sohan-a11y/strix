{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "strix": {
        "type": "local",
        "command": ["<absolute-path-to-repo>/.venv/Scripts/python.exe", "<absolute-path-to-repo>/mcp/server.py"],
        "cwd": "<absolute-path-to-repo>",
        "codemode": false,
        "timeout": { "startup": 120000 }
      }
    }
  }
}
