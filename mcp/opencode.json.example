{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "strix": {
        "type": "local",
        "command": [
          "C:\\path\\to\\repo\\.venv\\Scripts\\python.exe",
          "C:\\path\\to\\repo\\mcp\\server.py"
        ],
        "cwd": "C:\\path\\to\\repo",
        "codemode": false,
        "timeout": {
          "startup": 120000
        },
        "enabled": true
      }
    }
  }
}
